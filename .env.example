# Required runtime configuration. Do not commit real secrets.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
JWT_SECRET=replace-with-a-long-random-secret

# Frontend links used by password-reset and invitation emails.
FRONTEND_URL=https://delphiafit.com

# Optional SMTP delivery. Leave blank if email delivery is not configured yet.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_SSL=false

# Development/testing only. Keep false in production.
PASSWORD_RESET_DEBUG_RETURN_TOKEN=false
