# Required runtime configuration. Do not commit real secrets.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
JWT_SECRET=replace-with-a-long-random-secret

# Frontend links used by password-reset and invitation emails.
FRONTEND_URL=https://delphiafit.com

# Optional HTTPS origin for the isolated staging frontend (for example, your
# approved staging Vercel domain). Never use a wildcard or a production secret.
STAGING_FRONTEND_ORIGIN=

# Optional SMTP delivery. Leave blank if email delivery is not configured yet.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_SSL=false

# Optional: enable open-ended AI Coach responses through the OpenAI Responses API.
# Set OPENAI_API_KEY securely in Railway backend variables, never in GitHub or Vercel.
# If blank, AI Coach continues with a clearly labeled limited rule-based mode.
# Hosted model calls incur API charges. Configure API-side billing limits.
OPENAI_API_KEY=
DELPHIAFIT_AI_MODEL=gpt-6-luna

# Development/testing only. Keep false in production.
PASSWORD_RESET_DEBUG_RETURN_TOKEN=false
